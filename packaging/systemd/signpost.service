[Unit]
Description=apt-signpost: signed apt repository that 302-redirects to upstream .debs
Documentation=https://github.com/ophymx/apt-wharf
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=signpost
Group=signpost
ExecStart=/usr/bin/signpost serve --config /etc/signpost/config.yaml
# `systemctl reload signpost` → SIGHUP → re-read /etc/signpost/config.yaml
# and run an immediate refresh tick. Reloads that touch immutable fields
# (server.listen, paths.state_dir) are rejected with a logged error and
# the prior generation keeps serving — restart is required for those.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

# Filesystem
# StateDirectory= creates /var/lib/signpost on first start (safety net
# for non-deb installs); the deb's postinstall pre-creates it with the
# same 0750 mode, so pinning StateDirectoryMode= keeps systemd from
# logging a mode-mismatch warning. /etc/signpost is intentionally NOT
# declared as ConfigurationDirectory= because it must be root:signpost
# (admin-owned, daemon-readable) — systemd would create it owned by
# User=/Group= = signpost:signpost, which is the wrong trust model.
# The postinstall is the sole source of truth for /etc/signpost.
StateDirectory=signpost
StateDirectoryMode=0750
ReadWritePaths=/var/lib/signpost
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

# Privileges
NoNewPrivileges=true
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
